# Store jobs only in an IT-approved encrypted location.
STS_DATA_DIR=C:\ProgramData\VerbatimStudio\data

# Provision this file through the organization's approved software channel.
STS_MODEL_PATH=C:\ProgramData\VerbatimStudio\models\base.pt

# Folder batches are confined to this IT-approved workspace. Operators use relative folders inside it.
STS_BATCH_ROOT=C:\ProgramData\VerbatimStudio\batch-workspace

# Deterministic request budgets.
STS_MAX_UPLOAD_BYTES=2147483648
STS_MAX_BATCH_BYTES=10737418240
STS_MAX_BATCH_FILES=25
STS_MAX_MEDIA_SECONDS=14400
STS_FFMPEG_TIMEOUT_SECONDS=7200
STS_TRANSCRIPTION_TIMEOUT_SECONDS=7200
STS_RETENTION_DAYS=7
STS_MAX_JOBS=100

# Protected-recording foundation. Preview is opt-in; archive and Zoom remain off and unimplemented.
STS_MANIFEST_INTAKE_ENABLED=false
STS_PROTECTED_ARCHIVE_ENABLED=false
STS_ZOOM_CONNECTOR_ENABLED=false
STS_MAX_MANIFEST_BYTES=5242880
STS_IMPORT_PLAN_TTL_SECONDS=1800
STS_MAX_IMPORT_PLANS=100
